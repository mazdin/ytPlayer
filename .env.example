# ─── Server Config ───────────────────────────────────────────────────────────
PORT=3000

# ─── Admin Config ─────────────────────────────────────────────────────────────
ADMIN_SECRET=admin1111

# ─── Turso Database (Opsi A) ──────────────────────────────────────────────────
# Didapat dari dashboard Turso (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ─── Pusher Real-time (Opsi A) ────────────────────────────────────────────────
# Didapat dari dashboard Pusher (https://pusher.com)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=ap1
